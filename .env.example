# Environment Variables Template for Textile ERP Next.js
# Duplicate this file as .env and configure your database parameters

# MariaDB / MySQL Database Connection URL (Prisma schema connection)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://erp_user:erp_password@127.0.0.1:3306/textile_erp"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT / Session Secrets (Optional)
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"
